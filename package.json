  "license": "MIT",
  "type": "module",
  "main": "index.js",
  "engines": {
    "node": ">=22"
  },
  "files": [
    "index.js",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "openai-api",
    "gateway"
  ]
}
